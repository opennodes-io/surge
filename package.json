{
  "name": "@surge/monorepo",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "description": "Surge — a modern MCP client (desktop + mobile) that operates over MCP servers",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "pnpm --filter @surge/desktop dev",
    "build": "pnpm -r build",
    "build:core": "pnpm --filter @surge/core build",
    "build:server": "pnpm --filter @surge/bookmarks-history-mcp build",
    "build:desktop": "pnpm --filter @surge/desktop build",
    "typecheck": "pnpm -r typecheck",
    "test": "node scripts/test.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ],
    "overrides": {
      "fast-uri@>=3.0.0 <3.1.9": "^3.1.9",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "undici@>=6.0.0 <6.29.1": "^6.29.1",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "@xmldom/xmldom@>=0.9.0 <0.9.12": "^0.9.12",
      "browserslist@<4.28.7": "^4.28.7",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": "^2.11.0"
    }
  },
  "engines": {
    "node": ">=22.5"
  }
}
